{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure GUI",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build-gui",
                "-S", ".",
                "-G", "MinGW Makefiles",
                "-DBUILD_GUI=ON",
                "-DCMAKE_PREFIX_PATH=C:/Qt/6.11.2/mingw_64"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build Current Program",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build-gui",
                "--target", "${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]
}